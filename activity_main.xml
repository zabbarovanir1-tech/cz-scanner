<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMenu"
            style="@style/ToolbarButton"
            android:text="Меню" />
    </LinearLayout>

    <!-- Карточка результата последнего скана -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/idle"
        android:clickable="true"
        android:focusable="false"
        android:minHeight="140dp"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/cardTitle"
            style="@style/CardText"
            android:text="Отсканируйте код"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardProduct"
            style="@style/CardText"
            android:layout_marginTop="4dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cardDetails"
            style="@style/CardText"
            android:layout_marginTop="6dp"
            android:alpha="0.92"
            android:text="Наведите сканер ТСД на код DataMatrix и нажмите кнопку сканирования"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cardCode"
            style="@style/CardText"
            android:layout_marginTop="6dp"
            android:alpha="0.8"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Поле ввода: сюда «печатает» сканер в режиме клавиатуры -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="4dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Код сканера или ввод вручную"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:maxLines="1"
            android:singleLine="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnKeyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Абв" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Проверить" />
    </LinearLayout>

    <TextView
        android:id="@+id/counters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingTop="2dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/textSecondary"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#DDE3E7"
        android:dividerHeight="1dp"
        android:focusable="false" />
</LinearLayout>
